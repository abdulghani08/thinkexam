/// Firebase Options Configuration
/// 
/// This file should be generated automatically by FlutterFire CLI:
/// flutterfire configure
/// 
/// Or manually copy from Firebase Console after adding your app.
/// 
/// IMPORTANT: Rename this file to firebase_options.dart after filling in the values.
/// This file is already in .gitignore to protect sensitive credentials.

import 'package:firebase_core/firebase_core.dart' show FirebaseOptions;
import 'package:flutter/foundation.dart'
    show defaultTargetPlatform, kIsWeb, TargetPlatform;

/// Default Firebase options for the current platform.
FirebaseOptions get currentPlatform {
  if (kIsWeb) {
    throw UnimplementedError(
      'No default web configuration available. '
      'Add web configuration in firebase_options.dart',
    );
  }
  switch (defaultTargetPlatform) {
    case TargetPlatform.android:
      throw UnimplementedError(
        'No default Android configuration available. '
        'Add Android configuration in firebase_options.dart',
      );
    case TargetPlatform.iOS:
      throw UnimplementedError(
        'No default iOS configuration available. '
        'Add iOS configuration in firebase_options.dart',
      );
    case TargetPlatform.macOS:
      throw UnimplementedError(
        'No default macOS configuration available. '
        'Add macOS configuration in firebase_options.dart',
      );
    case TargetPlatform.windows:
      throw UnimplementedError(
        'No default Windows configuration available. '
        'Add Windows configuration in firebase_options.dart',
      );
    case TargetPlatform.linux:
      throw UnimplementedError(
        'No default Linux configuration available. '
        'Add Linux configuration in firebase_options.dart',
      );
    default:
      throw UnimplementedError(
        'DefaultFirebaseOptions have not been configured for $defaultTargetPlatform',
      );
  }
}

